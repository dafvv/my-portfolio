# Cloudflare Pages / Netlify Cache-Control Headers

# Static immutable Astro hashed bundles
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media assets & icons
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML pages and dynamic routes - always revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
