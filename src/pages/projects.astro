---
import RootLayout from '@/layouts/RootLayout.astro';
import ProjectSlider from '@/components/ProjectSlider';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((p) => ({
    id: p.id,
    projectNumber: p.data.projectNumber,
    title: p.data.title,
    description: p.data.description,
    stack: p.data.stack,
    previewImage: p.data.previewImage,
    link: p.data.link,
    github: p.data.github,
    metrics: p.data.metrics,
  }));
---

<RootLayout 
  description="Selected engineering projects, distributed systems, and user interfaces built by Daffa Bisma Rudidharma."
>
  <div class="flex flex-col space-y-12">
    <!-- Header -->
    <header class="flex flex-col space-y-2">
      <h1 class="font-mono text-[36px] sm:text-[48px] uppercase tracking-tight text-[#191919] dark:text-[#f2f0ef]">
        PROJECTS
      </h1>
      <p class="font-sans text-[18px] sm:text-[20px] text-[#191919] dark:text-[#f2f0ef] opacity-80 max-w-2xl">
        Architected for speed, modularity, and zero-compromise reliability.
      </p>
    </header>

    <!-- Interactive Project Showcase (Figma Nodes 5:55 & 8:372) -->
    <section class="pt-4" aria-label="Projects Carousel">
      <ProjectSlider client:idle projects={sortedProjects} />
    </section>
  </div>
</RootLayout>
