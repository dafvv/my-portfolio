---
import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout>
  <div class="flex flex-col space-y-24 md:space-y-32">
    
    <!-- Hero Section (Figma Hero Section) -->
    <header class="flex flex-col space-y-4 pt-4 md:pt-8" aria-label="Introduction">
      <h1 class="font-mono text-[48px] sm:text-[72px] lg:text-[96px] font-normal uppercase leading-[1.05] tracking-tight text-[#191919] dark:text-[#f2f0ef]">
        DAFFA BISMA<br />RUDIDHARMA
      </h1>
      <p class="font-sans text-[20px] sm:text-[24px] text-[#191919] dark:text-[#f2f0ef] opacity-90">
        Full-stack Developer
      </p>
    </header>

    <!-- Section 1: Portrait & About Me (Figma Section 1) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center" aria-label="About Me Section">
      <!-- Portrait Image Box (360x464px ratio) -->
      <div class="lg:col-span-5 aspect-[360/464] max-w-[360px] w-full bg-[#d9d9d9] dark:bg-[#262626] border border-[#191919] dark:border-[#f2f0ef] overflow-hidden">
        <img 
          src="/media/images/portrait.avif" 
          alt="Daffa Bisma Rudidharma Portrait" 
          width="360"
          height="464"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- About Me Text -->
      <div class="lg:col-span-7 flex flex-col space-y-4">
        <div>
          <h2 class="font-mono text-[28px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef] tracking-tight">
            ABOUT ME
          </h2>
          <div class="h-px bg-[#191919] dark:bg-[#f2f0ef] w-full mt-3 mb-6" aria-hidden="true"></div>
        </div>
        <p class="font-sans text-[18px] sm:text-[20px] leading-relaxed text-[#191919] dark:text-[#f2f0ef]">
          I am a 3rd-year Software Engineering student at IPB University focusing on full-stack web development and UI/UX design.
          My background spans hands-on development and project management, keeping workflows organized and delivered on schedule. I build functional web applications with clean and intuitive design.
        </p>
      </div>
    </section>

    <!-- Section 2: Motivation (Figma Section 2) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center" aria-label="Motivation Section">
      <div class="lg:col-span-7 flex flex-col space-y-4 order-2 lg:order-1">
        <div>
          <h2 class="font-mono text-[28px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef] tracking-tight">
            MOTIVATION
          </h2>
          <div class="h-px bg-[#191919] dark:bg-[#f2f0ef] w-full mt-3 mb-6" aria-hidden="true"></div>
        </div>
        <div class="space-y-4 font-sans text-[18px] sm:text-[20px] leading-relaxed text-[#191919] dark:text-[#f2f0ef]">
          <p>
            I see AI as a co-pilot, not a replacement for human judgment. The goal is to offload repetitive tasks and accelerate workflows while keeping critical thinking, design decisions, and system architecture in human hands.
          </p>
          <p>
            Real leverage comes from AI literacy, not blind automation. Using these tools effectively requires understanding how they work, where they fail, and how to verify their output. I build software with this approach in mind. Using AI to assist execution while maintaining full control over the underlying logic.
          </p>
        </div>
      </div>

      <!-- Motivation Visual Box (456x200px ratio) -->
      <div class="lg:col-span-5 aspect-[456/200] max-w-[456px] w-full bg-[#d9d9d9] dark:bg-[#262626] border border-[#191919] dark:border-[#f2f0ef] overflow-hidden order-1 lg:order-2">
        <img 
          src="/media/images/motivation.avif" 
          alt="Motivation Visual" 
          width="456"
          height="200"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    </section>

    <!-- Section 3: Skills Matrix (Figma Skill Section) -->
    <section class="flex flex-col space-y-8" aria-label="Skills Section">
      <div>
        <h2 class="font-mono text-[28px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef] tracking-tight">
          SKILLS
        </h2>
        <div class="h-px bg-[#191919] dark:bg-[#f2f0ef] w-full mt-3 mb-8" aria-hidden="true"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
        <!-- Frontend Column -->
        <div class="flex flex-col space-y-4">
          <h3 class="font-mono text-[24px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef]">
            FRONTEND
          </h3>
          <ul class="list-disc ms-8 font-sans text-[18px] sm:text-[20px] text-[#191919] dark:text-[#f2f0ef] space-y-2">
            <li>TypeScript</li>
            <li>React</li>
            <li>Tailwind CSS</li>
          </ul>
        </div>

        <!-- Backend Column -->
        <div class="flex flex-col space-y-4">
          <h3 class="font-mono text-[24px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef]">
            BACKEND
          </h3>
          <ul class="list-disc ms-8 font-sans text-[18px] sm:text-[20px] text-[#191919] dark:text-[#f2f0ef] space-y-2">
            <li>TypeScript</li>
            <li>PHP</li>
            <li>Laravel</li>
            <li>SQL</li>
          </ul>
        </div>

        <!-- Tools Column -->
        <div class="flex flex-col space-y-4">
          <h3 class="font-mono text-[24px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef]">
            TOOLS
          </h3>
          <ul class="list-disc ms-8 font-sans text-[18px] sm:text-[20px] text-[#191919] dark:text-[#f2f0ef] space-y-2">
            <li>Figma</li>
            <li>Affinity</li>
            <li>Antigravity</li>
            <li>Git</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Bottom Quick Links (Figma Bottom Right Nav) -->
    <nav class="flex flex-col items-end space-y-4 pt-12" aria-label="Featured Directory">
      <a 
        href="/projects" 
        data-astro-prefetch
        class="font-mono text-[28px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef] hover:underline underline-offset-8 transition-transform hover:-translate-x-2 focus-visible:ring-2"
      >
        PROJECTS →
      </a>
      <a 
        href="/blog" 
        data-astro-prefetch
        class="font-mono text-[28px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef] hover:underline underline-offset-8 transition-transform hover:-translate-x-2 focus-visible:ring-2"
      >
        Blog →
      </a>
    </nav>

  </div>
</RootLayout>
