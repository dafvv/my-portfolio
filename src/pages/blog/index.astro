---
import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout 
  description="Technical insights, engineering architecture, and reflections by Daffa Bisma Rudidharma."
>
  <div class="flex flex-col min-h-[60vh] justify-between space-y-12">
    
    <!-- Blog Section Header -->
    <header class="flex flex-col space-y-3">
      <h1 class="font-mono text-[32px] sm:text-[40px] uppercase tracking-tight text-[#191919] dark:text-[#f2f0ef]">
        PERSONAL BLOG
      </h1>
      <div class="h-px bg-[#191919] dark:bg-[#f2f0ef] w-full" aria-hidden="true"></div>
    </header>

    <!-- Centered Coming Soon Section -->
    <section class="flex flex-col items-center justify-center my-auto py-24 text-center space-y-4" aria-label="Coming Soon Notice">
      <span class="font-mono text-[28px] sm:text-[36px] md:text-[44px] uppercase tracking-widest font-normal text-[#191919] dark:text-[#f2f0ef]">
        COMING SOON
      </span>
      <div class="h-px bg-[#191919] dark:bg-[#f2f0ef] w-24 mx-auto my-2" aria-hidden="true"></div>
      <p class="font-sans text-[16px] sm:text-[18px] text-[#191919] dark:text-[#f2f0ef] opacity-75 max-w-md">
        Articles and technical write-ups are currently in progress.
      </p>
    </section>

    <div></div>
  </div>
</RootLayout>
