---
import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout>
  <div class="flex flex-col items-start justify-center min-h-[60vh] space-y-6">
    <span class="font-mono text-[72px] sm:text-[96px] font-bold text-[#191919] dark:text-[#f2f0ef]">
      404
    </span>
    <h1 class="font-mono text-[24px] sm:text-[32px] uppercase text-[#191919] dark:text-[#f2f0ef]">
      PAGE_NOT_FOUND
    </h1>
    <div class="h-px bg-[#191919] dark:bg-[#f2f0ef] w-full max-w-md" aria-hidden="true"></div>
    <p class="font-sans text-[18px] sm:text-[20px] text-[#191919] dark:text-[#f2f0ef] opacity-80">
      The requested route does not exist or has been relocated.
    </p>
    <a 
      href="/" 
      class="mt-4 px-6 py-3 border border-[#191919] dark:border-[#f2f0ef] bg-[#d9d9d9] dark:bg-[#262626] font-mono text-[14px] uppercase tracking-wider hover:opacity-80 focus-visible:ring-2"
    >
      Return Home →
    </a>
  </div>
</RootLayout>
